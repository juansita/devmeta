{
  "name": "devmeta-slides",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "slidev slides.md --open",
    "build": "slidev build slides.md",
    "export": "slidev export slides.md",
    "slides": "node scripts/count-slides.mjs",
    "diagrams": "slidev build slides.md --out .diagram-check >/dev/null && node scripts/verify-diagrams.mjs .diagram-check",
    "layout": "slidev build slides.md --out .layout-check >/dev/null && node scripts/verify-layout.mjs .layout-check"
  },
  "devDependencies": {
    "@slidev/cli": "^52.19.0",
    "@slidev/theme-default": "^0.25.0",
    "@slidev/theme-seriph": "^0.25.0",
    "playwright-chromium": "^1.56.0",
    "vue": "^3.5.0"
  }
}
